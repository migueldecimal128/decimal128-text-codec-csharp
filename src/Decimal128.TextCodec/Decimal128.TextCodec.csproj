<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Decimal128.TextCodec</RootNamespace>
    <AssemblyName>Decimal128.TextCodec</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Package identity. Version tracks the other ports, which all declare
         0.9.0; without it this would build as the .NET default 1.0.0 and claim
         to be the most mature of the family. -->
    <PackageId>Decimal128.TextCodec</PackageId>
    <Version>0.9.0</Version>
    <Authors>MiguelDecimal128</Authors>
    <Description>Thin BID128/DPD128 &#8596; text codec for IEEE 754-2019 decimal128, in C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/migueldecimal128/decimal128-text-codec-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/migueldecimal128/decimal128-text-codec-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>decimal128;decimal;ieee754;bid;dpd;codec</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CheckForOverflowUnderflow is stated rather than assumed. Several sites
         in the codec rely on wrapping 64-bit arithmetic: the coefficient
         increment that carries into the high word, the 128-bit products taken
         modulo 2^128, the accumulators past the digit limit whose values are
         then discarded. The Swift port spells each of them with its wrapping
         operators; here they are plain operators, and this property is what
         guarantees they stay plain. Each such site carries a comment saying why
         the wrap is the intended arithmetic. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!-- VERIFY_ENABLED arms the internal-state assertions, exactly as the Swift
       port's Package.swift does and for the same reason: it is defined for
       Debug only, because a release consumer compiles against this library and
       must not take a throw inside it on data they do not control. The demand
       checks (buffer sizing and the precision invariant) are live in every
       configuration regardless. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);VERIFY_ENABLED</DefineConstants>
  </PropertyGroup>

</Project>
